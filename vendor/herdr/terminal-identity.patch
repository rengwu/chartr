+    /// A killed or suspended foreground job cannot undo its mouse modes.
+    /// Only recover on a known return to the owning shell: unknown probes,
+    /// a live job (including a reattachment), and shell-owned modes survive.
+    pub fn recover_mouse_reporting(
+        &self,
+        shell_pid: u32,
+        foreground_pgid: Option<u32>,
+        previous_pgid: Option<u32>,
+    ) -> bool {
+        if shell_pid == 0
+            || foreground_pgid != Some(shell_pid)
+            || !previous_pgid.is_some_and(|previous| previous != shell_pid)
+        {
+            return false;
+        }
+        let Ok(mut core) = self.ghostty.core.lock() else {
+            return false;
+        };
+        if !core.terminal.mouse_tracking_enabled().unwrap_or(false) {
+            return false;
+        }
+        // Change modes directly, without disturbing a partial escape sequence,
+        // the screen, scrollback, or shell settings such as bracketed paste.
+        for mode in [9, 1000, 1002, 1003, 1005, 1006, 1015, 1016] {
+            let _ = core.terminal.mode_set(mode, false);
+        }
+        true
     }
 
